# Copy this file to .env and replace every example value before starting.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
API_KEY=replace-with-a-long-random-api-key

Rhid__BaseUrl=https://www.rhid.com.br
Rhid__LoginRoute=/v2/#/login
Rhid__UnlockRoute=/v2/#/desbloqueio_rep_violacao
Rhid__Email=service-account@example.invalid
Rhid__Password=replace-with-the-rhid-service-password
Rhid__NavigationTimeoutSeconds=30
Rhid__ActionTimeoutSeconds=30

PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
HOST_PORT=4563
SHM_SIZE=2gb
LOGS_PATH=./Logs
